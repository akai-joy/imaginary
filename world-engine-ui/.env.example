# Copy to `.env` and fill in. With NO values set, the app runs in demo mode
# (mock data + a demo sign-in) so you can click through the UI immediately.

# --- Backend API (your deployed FastAPI service) ---
# Leave blank to use built-in mock data.
VITE_API_BASE_URL=

# --- Firebase Authentication (Google sign-in) ---
# From Firebase console > Project settings > Your apps > Web app config.
# Leave blank to use demo sign-in instead of real Google auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
